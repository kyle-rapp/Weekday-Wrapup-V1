rules_version = '2';
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'userName', 'text', 'createdAt']);
        allow update: if signedIn();
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;

        match /replies/{replyId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.keys().hasAll(['userId', 'userName', 'text', 'createdAt']);
          allow update: if signedIn();
          allow delete: if signedIn() && resource.data.userId == request.auth.uid;
        }
      }

      /// Soft reactions: one doc per user per reaction `type` per post — id must be `{uid}__{type}`.
      match /reactions/{reactionId} {
        allow read: if signedIn();

        function validSoftReactionType(t) {
          return t == 'here_for_you' || t == 'proud' || t == 'thinking';
        }

        allow create: if signedIn()
          && validSoftReactionType(request.resource.data.type)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'type', 'createdAt'])
          && reactionId == request.auth.uid + '__' + request.resource.data.type;

        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;

        allow update: if false;
      }
    }

    match /userReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.keys().hasAll(['followerId', 'followingId', 'createdAt']);
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && (
          request.auth.uid == resource.data.ownerId
          || (
            resource.data.keys().hasAny(['adminIds'])
            && request.auth.uid in resource.data.adminIds
          )
        );
      allow delete: if signedIn()
        && request.auth.uid == resource.data.ownerId;
    }

    match /dopamineMenus/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /// Top-level user document + subcollections. Reads: any signed-in user. Writes: only the owner document.
    match /users/{userId} {
      // `read` = get + list for collections; authenticated members can read profiles.
      allow read: if signedIn();
      // Owner-only writes on the user root document (merge updates, display name, etc.).
      allow create, update, delete: if signedIn() && request.auth.uid == userId;

      match /profile/{docId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      match /preferences/{docId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      match /recommendationFeedback/{docId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId;
      }

      match /support/{docId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      match /supportInbox/{docId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.keys().hasAll(['fromUserId', 'type', 'createdAt']);
        allow update, delete: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
