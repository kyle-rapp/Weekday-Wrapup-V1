rules_version = '2';
// Deploy with: firebase deploy --only firestore:rules
// Publish in Firebase Console → Firestore → Rules → Publish (required for app to use these rules).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          !('authorId' in request.resource.data)
          || request.resource.data.authorId == request.auth.uid
        );
      allow update: if signedIn()
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.userId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'userReactions'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        );
      allow delete: if signedIn()
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.userId == request.auth.uid
        );

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'userName', 'text', 'createdAt']);
        allow update: if signedIn();
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;

        match /replies/{replyId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.keys().hasAll(['userId', 'userName', 'text', 'createdAt']);
          allow update: if signedIn();
          allow delete: if signedIn() && resource.data.userId == request.auth.uid;
        }
      }

      match /reactions/{reactionId} {
        allow read: if signedIn();

        function validSoftReactionType(t) {
          return t == 'here_for_you' || t == 'proud' || t == 'thinking';
        }

        allow create: if signedIn()
          && validSoftReactionType(request.resource.data.type)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'type', 'createdAt'])
          && reactionId == request.auth.uid + '__' + request.resource.data.type;

        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;

        allow update: if false;
      }
    }

    match /userReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.reportId == reportId
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasAll(['reportId', 'reporterUserId', 'reason', 'createdAt', 'status']);
      allow read, update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.keys().hasAll(['followerId', 'followingId', 'createdAt']);
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.followerId == request.auth.uid
        && request.resource.data.followerId == request.auth.uid;
    }

    match /following/{userId}/userFollowing/{targetUid} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && targetUid != userId
        && request.resource.data.followingId == targetUid;
      allow delete: if isOwner(userId);
    }

    match /followers/{userId}/userFollowers/{followerUid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == followerUid;
      allow delete: if signedIn() && request.auth.uid == followerUid;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && (
          request.auth.uid == resource.data.ownerId
          || (
            resource.data.keys().hasAny(['adminIds'])
            && request.auth.uid in resource.data.adminIds
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && (
              (!(request.auth.uid in resource.data.memberIds) && request.auth.uid in request.resource.data.memberIds)
              || (request.auth.uid in resource.data.memberIds && !(request.auth.uid in request.resource.data.memberIds))
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'adminIds'])
            && request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
          )
        );
      allow delete: if signedIn()
        && request.auth.uid == resource.data.ownerId;
    }

    match /default_groups/{groupId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /group_admin_votes/{groupId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /dopamineMenus/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /thinking_of_you/{docId} {
      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId);

      match /profile/{docId} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /preferences/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /blockedUsers/{blockedUserId} {
        allow read: if isOwner(userId)
          || (signedIn() && request.auth.uid == blockedUserId);
        allow write: if isOwner(userId);
      }

      match /recommendationFeedback/{docId} {
        allow read, create: if isOwner(userId);
      }

      match /recommendationMemory/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /habitSignals/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /insights/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /adaptiveProfile/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /eventStream/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /nudges/{nudgeId} {
        allow read, write: if isOwner(userId);
      }

      match /support/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /supportInbox/{docId} {
        allow read: if isOwner(userId);
        allow create: if signedIn()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.keys().hasAll(['fromUserId', 'type', 'createdAt']);
        allow update, delete: if isOwner(userId);
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.keys().hasAll(['participantIds', 'updatedAt']);
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }
  }
}
